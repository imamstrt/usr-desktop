<Window x:Class="SmiWifiProvisioning.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmiWifiProvisioning.ViewModels"
        xmlns:views="clr-namespace:SmiWifiProvisioning.Views"
        Title="SMI WIFI PRODUCTION TOOLS V01 (.NET 9)" 
        Height="700" Width="1100"
        MinHeight="550" MinWidth="900"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">

    <!-- Pemetaan Otomatis ViewModel ke View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConfigProduksiViewModel}">
            <views:ConfigProduksiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigUsrViewModel}">
            <views:ConfigUsrView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigAdminViewModel}">
            <views:ConfigAdminView />
        </DataTemplate>

        <!-- Pemetaan Halaman Baru -->
        <DataTemplate DataType="{x:Type vm:FunctionTestViewModel}">
            <views:FunctionTestView />
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation Menu -->
        <Border Grid.Column="0" Background="#252526" Padding="10">
            <StackPanel>
                <TextBlock Text="MENU UTAMA" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,5,0,20" HorizontalAlignment="Center"/>

                <Button Content="Config Produksi" 
                        Command="{Binding NavigateToConfigProduksiCommand}"
                        Height="40" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left"/>

                <Button Content="Config USR" 
                        Command="{Binding NavigateToConfigUsrCommand}"
                        Height="40" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left"/>

                <Button Content="Config Admin" 
                        Command="{Binding NavigateToConfigAdminCommand}"
                        Height="40" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left"/>

                <!-- Tombol Navigasi Baru -->
                <Button Content="Function Test" 
                        Command="{Binding NavigateToFunctionTestCommand}"
                        Height="40" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Area Konten Utama -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>