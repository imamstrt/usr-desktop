<Window x:Class="SmiWifiProvisioning.Views.WifiScanResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hasil Pemindaian Wi-Fi" Height="360" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridWifi" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  MouseDoubleClick="GridWifi_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="180"/>
                <DataGridTextColumn Header="Signal" Binding="{Binding SignalBar}" Width="80"/>
                <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="60"/>
                <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Pilih Wi-Fi" Click="BtnSelect_Click" Height="32" Margin="0,10,0,0" FontWeight="Bold"/>
    </Grid>
</Window>