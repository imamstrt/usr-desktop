<UserControl x:Class="SmiWifiProvisioning.Views.FunctionTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Loaded="UserControl_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Status Wi-Fi Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Pengujian Fungsi (Wi-Fi &amp; DLMS Meter Test)" 
                       FontSize="22" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>

            <!-- Wi-Fi Status Badge -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWifiConnected}" Value="True">
                                <Setter Property="Background" Value="#E1EFFE"/>
                                <Setter Property="BorderBrush" Value="#3182CE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📶 " FontSize="12"/>
                    <TextBlock Text="{Binding WifiStatusText}" FontWeight="Bold" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWifiConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Section 1: Input Barcode Scanner -->
        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scan SSID / Meter ID (11 Char):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="0,0,15,0"/>
                <TextBox Grid.Column="1" x:Name="TxtBarcodeInput" 
                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="11" FontSize="16" FontWeight="Bold" Padding="8,5"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
            </Grid>
        </Border>

        <!-- Section 2: Status Indicator Card -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestResultStatus}" Value="OK">
                            <Setter Property="Background" Value="#DEF7EC"/>
                            <Setter Property="BorderBrush" Value="#31C48D"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestResultStatus}" Value="FAILED">
                            <Setter Property="Background" Value="#FDE8E8"/>
                            <Setter Property="BorderBrush" Value="#F98080"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestResultStatus}" Value="TESTING">
                            <Setter Property="Background" Value="#E1EFFE"/>
                            <Setter Property="BorderBrush" Value="#76A9FA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STATUS PROSES:" FontSize="12" FontWeight="Bold" Foreground="#4B5563"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding TestResultStatus}" 
                           FontSize="28" FontWeight="Black" VerticalAlignment="Center" Margin="20,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestResultStatus}" Value="OK">
                                    <Setter Property="Foreground" Value="#0E9F6E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestResultStatus}" Value="FAILED">
                                    <Setter Property="Foreground" Value="#E02424"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestResultStatus}" Value="TESTING">
                                    <Setter Property="Foreground" Value="#1C64F2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Section 3: Response Terminal Log -->
        <GroupBox Grid.Row="3" Header="Riwayat Frame DLMS (TX/RX)" Foreground="#374151" FontWeight="SemiBold">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Margin="0,5,0,0">
                <TextBox Text="{Binding DeviceResponseHex, Mode=OneWay}" 
                         Foreground="#33FF33" Background="Transparent" BorderThickness="0" 
                         FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="Wrap" Padding="10"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>